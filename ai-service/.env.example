# Database Configuration
DATABASE_URL=sqlite:///./confidence.db

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true

# File Upload Configuration
UPLOAD_FOLDER=uploads
MAX_FILE_SIZE_MB=100

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Model Configuration
WHISPER_MODEL=base
FACE_CASCADE_PATH=haarcascade_frontalface_default.xml
SMILE_CASCADE_PATH=haarcascade_smile.xml

# Analysis Thresholds
POSTURE_THRESHOLD=0.05
EYE_CONTACT_THRESHOLD=0.1
MIN_EYE_CONTACT_PERCENTAGE=60
MIN_FACE_VISIBILITY=70
MIN_SMILE_PERCENTAGE=40
MIN_POSTURE_PERCENTAGE=60
MIN_SPEECH_SCORE=70
MIN_HAND_MOVEMENT=20
MAX_HAND_MOVEMENT=70

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Speech Analysis
FILLER_WORDS=um,uh,like,basically,actually
IDEAL_WORDS_PER_MINUTE_MIN=100
IDEAL_WORDS_PER_MINUTE_MAX=170
